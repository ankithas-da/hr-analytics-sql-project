    <worksheet name='S1 KPI Tiles'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Talent Acquisition' name='federated.0wgqkag0bredyd1g87p2s1iu2rdr' />
          </datasources>
          <datasource-dependencies datasource='federated.0wgqkag0bredyd1g87p2s1iu2rdr'>
            <column caption='Total Applications' datatype='integer' default-format='N' name='[Calculation_1142999344885760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([application_id])' />
            </column>
            <column caption='Total Interviews' datatype='integer' default-format='N' name='[Calculation_1142999344996354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([interview_id])' />
            </column>
            <column caption='Total Offers Made' datatype='integer' default-format='N' name='[Calculation_1142999345598468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([offer_id])' />
            </column>
            <column caption='Total Offers Accepted' datatype='integer' default-format='N' name='[Calculation_1142999346651141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [offer_status] = &apos;Accepted&apos; THEN [offer_id] END)' />
            </column>
            <column caption='Total Hires' datatype='integer' default-format='N' name='[Calculation_1142999346757639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [application_status] = &apos;Hired&apos; THEN [application_id] END)' />
            </column>
            <column caption='Offer Acceptance Rate' datatype='real' default-format='p0.0%' name='[Calculation_1142999346901000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1142999346651141] / [Calculation_1142999345598468]' />
            </column>
            <column caption='Days to Fill (per Requisition)' datatype='integer' default-format='N' name='[Calculation_1142999347785739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [opening_date], [closing_date])' />
            </column>
            <column caption='Avg Days to Fill (Closed Reqs)' datatype='integer' datatype-customized='true' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1142999347908620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(AVG(IF [requisition_status] = &apos;Closed&apos; THEN [Calculation_1142999347785739] END))' />
            </column>
            <column caption='Open Positions Count' datatype='integer' name='[Calculation_1142999348113421]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [requisition_status] = &apos;Open&apos; THEN [positions_count] END)' />
            </column>
            <column caption='Application Id' datatype='integer' name='[application_id]' role='dimension' type='ordinal' />
            <column caption='Application Status' datatype='string' name='[application_status]' role='dimension' type='nominal' />
            <column caption='Closing Date' datatype='date' name='[closing_date]' role='dimension' type='ordinal' />
            <column caption='Department Name' datatype='string' name='[department_name]' role='dimension' type='nominal' />
            <column caption='Interview Id' datatype='integer' name='[interview_id]' role='dimension' type='ordinal' />
            <column caption='Offer Id' datatype='integer' name='[offer_id]' role='dimension' type='ordinal' />
            <column caption='Offer Status' datatype='string' name='[offer_status]' role='dimension' type='nominal' />
