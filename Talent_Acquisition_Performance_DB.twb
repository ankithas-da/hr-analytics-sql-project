    <worksheet name='S4 Source Conversion'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='10'>Which recruitment sources turn applicants into hires</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Talent Acquisition' name='federated.0wgqkag0bredyd1g87p2s1iu2rdr' />
          </datasources>
          <datasource-dependencies datasource='federated.0wgqkag0bredyd1g87p2s1iu2rdr'>
            <column caption='Total Applications' datatype='integer' default-format='N' name='[Calculation_1142999344885760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([application_id])' />
            </column>
            <column caption='Total Hires' datatype='integer' default-format='N' name='[Calculation_1142999346757639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [application_status] = &apos;Hired&apos; THEN [application_id] END)' />
            </column>
            <column caption='Hire Conversion Rate' datatype='real' default-format='p0.0%' name='[Calculation_1142999347064841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1142999346757639] / [Calculation_1142999344885760]' />
            </column>
            <column caption='Application Id' datatype='integer' name='[application_id]' role='dimension' type='ordinal' />
            <column caption='Application Status' datatype='string' name='[application_status]' role='dimension' type='nominal' />
            <column caption='Department Name' datatype='string' name='[department_name]' role='dimension' type='nominal' />
            <column-instance column='[recruitment_source]' derivation='None' name='[none:recruitment_source:nk]' pivot='key' type='nominal' />
            <column caption='Recruitment Source' datatype='string' name='[recruitment_source]' role='dimension' type='nominal' />
            <column caption='Requisition Status' datatype='string' name='[requisition_status]' role='dimension' type='nominal' />
