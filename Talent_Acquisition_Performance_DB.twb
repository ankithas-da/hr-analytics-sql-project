    <worksheet name='S7 Offer Outcome'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Bookman Old Style' fontsize='10'>Declined offers range from 12.7% in Sales to 18.2% in Finance</run>
