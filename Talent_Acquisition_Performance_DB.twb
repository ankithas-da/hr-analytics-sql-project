    <worksheet name='S5 Source Retention'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Bookman Old Style' fontsize='10'>Which recruitment sources keep hires for a year</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Employees' name='federated.1ktgqah1589s9q1eoa91z1pzk0ox' />
          </datasources>
          <datasource-dependencies datasource='federated.1ktgqah1589s9q1eoa91z1pzk0ox'>
            <column caption='Retained 1 Year Flag' datatype='integer' default-format='p0.0%' name='[Calculation_1142999349932049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([exit_date]) OR DATEDIFF(&apos;day&apos;, [hire_date], [exit_date]) &gt; 365 THEN 1 ELSE 0 END' />
            </column>
            <column caption='1-Year Retention Rate' datatype='real' default-format='p0.0%' name='[Calculation_1142999350063122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1142999349932049]) / COUNT([employee_id])' />
            </column>
            <column caption='Employee Id' datatype='integer' name='[employee_id]' role='dimension' type='ordinal' />
            <column caption='Exit Date' datatype='date' name='[exit_date]' role='dimension' type='ordinal' />
            <column caption='Hire Date' datatype='date' name='[hire_date]' role='dimension' type='ordinal' />
            <column-instance column='[recruitment_source]' derivation='None' name='[none:recruitment_source:nk]' pivot='key' type='nominal' />
