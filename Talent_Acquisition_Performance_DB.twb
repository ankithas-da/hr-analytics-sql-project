    <worksheet name='S6 Time to Fill'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Bookman Old Style' fontsize='10'>Customer Support takes longest to fill a role: 63 days against a 59-day average</run>
          </formatted-text>
